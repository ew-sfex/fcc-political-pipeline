# Database - leave unset locally to default to sqlite:///pipeline.db.
# In production set to a hosted Postgres pooled connection string (Supabase).
DATABASE_URL=

# Path to the station config
STATION_CONFIG_PATH=config/bay_area_stations.yaml

# Only ingest filings uploaded on/after this date (YYYY-MM-DD). Older
# year-folders are pruned without walking. Defaults to 2025-01-01.
BACKFILL_SINCE=2025-01-01

# Slack incoming-webhook URL for new-filing alerts. Leave unset to disable
# alerts (e.g. local runs). Create at api.slack.com/messaging/webhooks.
SLACK_WEBHOOK_URL=

# Set to 1 to suppress Slack alerts for a run regardless of count - use for
# the one-off history backfill so it doesn't fire one huge alert.
SUPPRESS_ALERTS=

# Optional: cap how many new filings to write per run (safety valve)
MAX_FILINGS_PER_RUN=20000

# --- Deferred until PDF downloads are unblocked (see README) ---
# Google Drive service account: path to JSON key file, or raw JSON contents.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Destination Drive folder ID (from the folder's URL)
DRIVE_ROOT_FOLDER_ID=
