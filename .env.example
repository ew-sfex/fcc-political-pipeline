# Database - leave unset locally to default to sqlite:///pipeline.db
DATABASE_URL=

# Google Drive service account - either:
#  a) path to the JSON key file, OR
#  b) the raw JSON contents (used in GitHub Actions via secret)
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service_account.json

# Destination Drive folder ID (from the folder's URL)
DRIVE_ROOT_FOLDER_ID=

# Path to the station config
STATION_CONFIG_PATH=config/bay_area_stations.yaml

# Optional: cap how many new filings to process per run (safety valve)
MAX_FILINGS_PER_RUN=200
